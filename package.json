{
  "name": "badgify",
  "version": "1.0.0",
  "description": "High-end, aesthetic, minimalistic SVG badge generator and CLI for modern developers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "badgify": "./bin/badgify.js"
  },
  "files": [
    "dist",
    "bin",
    "badges"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup src/cli.ts --format esm",
    "test": "vitest run",
    "generate-catalog": "tsx scripts/generate-catalog.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "badge",
    "badges",
    "svg",
    "svg-badges",
    "svg-generator",
    "shields",
    "shields-io",
    "shields-alternative",
    "github",
    "github-badges",
    "readme",
    "readme-badges",
    "branding",
    "developer-tools",
    "minimalist",
    "minimalist-design",
    "aesthetic",
    "dark-mode",
    "light-mode",
    "tech-stack",
    "status-badges",
    "vector-icons",
    "cli",
    "cli-tool",
    "zero-telemetry",
    "local-first",
    "offline-first",
    "typescript",
    "nodejs",
    "react",
    "vue",
    "svelte",
    "astro",
    "nextjs",
    "docker",
    "kubernetes",
    "python",
    "rust",
    "golang",
    "ios",
    "android",
    "apple",
    "linux",
    "ubuntu",
    "windows",
    "gemini",
    "ai-friendly"
  ],
  "author": "a-kio",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "homepage": "https://a-kio.github.io/Badgify/",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-kio/Badgify.git"
  },
  "bugs": {
    "url": "https://github.com/a-kio/Badgify/issues"
  }
}